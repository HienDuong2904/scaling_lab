# Copy to .env (make up does this for you). Host ports only; containers talk on their internal ports.
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab
POSTGRES_DB=lab

# 5432 is often taken by another local Postgres, so the lab defaults to 5433.
PG_PORT=5433
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_UI_PORT=9001
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
CADVISOR_PORT=8081
TOXIPROXY_PORT=8474
FAKE_PARTNER_PORT=8080
HELLO_PORT=3100
NGINX_PORT=8000

MINIO_ROOT_USER=lab
MINIO_ROOT_PASSWORD=lab-secret

# HMAC secret the fake partner signs webhooks with; your apps verify with the same value.
PARTNER_WEBHOOK_SECRET=whsec_lab
