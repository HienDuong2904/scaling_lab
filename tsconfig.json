{
  // Shared services run TypeScript directly with Node 24's type stripping (no build step),
  // so only erasable syntax is allowed: no enums, namespaces or constructor parameter properties.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["shared/*/src/**/*.ts"]
}
